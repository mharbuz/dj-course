# LLM Engine Selection
ENGINE=GEMINI  # or LLAMA_CPP or OLLAMA

# Generation Parameters (shared across all engines)
TEMPERATURE=0.7
TOP_P=0.9
TOP_K=40

# Gemini Configuration
GEMINI_API_KEY=your_api_key_here
MODEL_NAME=gemini-2.5-flash

# LLaMA Configuration (if ENGINE=LLAMA_CPP)
LLAMA_MODEL_PATH=/path/to/model.gguf
LLAMA_GPU_LAYERS=1
LLAMA_CONTEXT_SIZE=2048

# Ollama Configuration (if ENGINE=OLLAMA)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=gpt-oss

# TTS (/audio command) – path to M2 text-to-speech-xtts CLI script
XTTS_CLI_PATH=/path/to/dj-course/M2/text-to-speech-xtts/tts_cli.py
# Optional: Python interpreter (e.g. M2 venv) if not using system python3
# PYTHON_PATH=/path/to/dj-course/M2/.venv/bin/python
